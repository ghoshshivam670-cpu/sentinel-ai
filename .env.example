# ==========================================
# SentinelAI Environment Configuration
# ==========================================

# Active Provider: "gemini", "openai", or "anthropic"
DEFAULT_LLM_PROVIDER=gemini

# Primary Model Name
# Examples:
# Gemini: gemini-3.5-flash-lite, gemini-3.8-flash
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-3-5-sonnet-20241022
MODEL_NAME=gemini-3.5-flash-lite

# API Keys (Provide at least one active provider key)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse Observability & Tracing (Optional but Recommended for Production)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Agent Engine Settings
MAX_SELF_HEALING_ITERATIONS=3
EXECUTION_TIMEOUT_SECONDS=15
ENABLE_HUMAN_IN_THE_LOOP=false
